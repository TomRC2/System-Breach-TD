  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &1532211713
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1532211712}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0760da73bdfb8ac4fb4ec2094127ddcf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  slides:
  - title: Welcome to System Breach TD
    description: Your computer is under attack by malware. Deploy defensive towers
      to stop waves of viruses, trojans and ransomware before they corrupt the Core.
    image: {fileID: -185844413, guid: 66410c4c3970fbf4590d96356056804b, type: 3}
  - title: Waves & Enemies
    description: Enemies come in waves, following the golden path across the board.
      Each enemy that reaches the Core deals damage equal to its remaining HP. Survive
      all waves to win!
    image: {fileID: -1513793657, guid: 7753364e193b37d4996451335a863a1e, type: 3}
  - title: The Core
    description: The Core is what you're defending. It starts with 1000 HP. If it
      reaches zero, it's game over. Keep an eye on the HP bar at the bottom of the
      screen.
    image: {fileID: -1639332984, guid: 51c5c5231af13a7438e8da28dd894578, type: 3}
  - title: Money & Placement
    description: You start each level with some RAM (money). Earn more by defeating
      enemies. Tap the Towers button to open the shop, select a tower and tap a green
      cell to place it. You can also sell towers for half their cost.
    image: {fileID: 1115102175, guid: 3ba36aa9592000347b1b21017b413df8, type: 3}
  - title: Tower Types
    description: Attack towers deal damage to enemies. Booster towers increase the
      stats of nearby attack towers. Farm towers generate passive money at the start
      of each wave. Combine them wisely!
    image: {fileID: -2141210500, guid: e5e24dd13ab7c7c4c9b2b0b6771a0730, type: 3}
  - title: Tower Info
    description: "Tap any placed tower to see its stats and range. From there you
      can change its targeting priority \u2014 First, Closest, Most HP and more \u2014
      to adapt to each situation."
    image: {fileID: -287828546, guid: c65428f6c36ac4746920a7d1340dd2ca, type: 3}
  - title: Upgrades
    description: "Each tower has 5 upgrade levels. Upgrading increases damage, attack
      speed and range. Invest in upgrades when you have spare RAM \u2014 a few upgraded
      towers beat many weak ones."
    image: {fileID: 1124697764, guid: 3ba1efabbb038244582228e3efa9a7f3, type: 3}
  - title: Score
    description: You earn points for every enemy defeated. Bosses give bonus points.
      Try to clear waves efficiently to maximize your score. Your best score per
      level is saved automatically.
    image: {fileID: -1130515983, guid: d4278447a38615d49ad9a732e85bb500, type: 3}
  - title: Play
    description: Press the button below to start the level
    image: {fileID: 0}
  slideImage: {fileID: 789144567}
  titleText: {fileID: 1093239501}
  descriptionText: {fileID: 922580577}
  slideCounterText: {fileID: 163566017}
  nextButton: {fileID: 2026472127}
  prevButton: {fileID: 635133916}
  startButton: {fileID: 1369386893}
  typingSpeed: 0.03
  tutorialPanel: {fileID: 259585231}
  levelSceneName: Level1
